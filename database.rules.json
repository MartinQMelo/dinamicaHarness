{
  "rules": {
    ".read": false,
    ".write": false,
    "admins": {
      "$email": {
        ".read": "auth != null && auth.token.email != null && auth.token.email.toLowerCase().replace('.', ',') === $email",
        ".write": false
      }
    },
    "salas": {
      ".read": "auth != null && auth.token.email != null && root.child('admins').child(auth.token.email.toLowerCase().replace('.', ',')).val() === true",
      ".write": "auth != null && auth.token.email != null && root.child('admins').child(auth.token.email.toLowerCase().replace('.', ',')).val() === true",
      "$sala": {
        "estado": {
          ".read": "auth != null"
        },
        "config": {
          "tamanhoGrupo": {
            ".read": "auth != null"
          },
          "frase": {
            ".read": "auth != null"
          },
          "criterios": {
            ".read": "auth != null && root.child('salas').child($sala).child('estado/fase').val().matches(/^(r1_avaliacao|r2|r2_troca|r2_declaracao|r3|resultado|oficina|votacao|fim)$/)"
          }
        },
        "alunos": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('salas').child($sala).child('estado').exists()",
            ".validate": "newData.hasChildren(['nome', 'grupo']) && newData.child('nome').isString() && newData.child('nome').val().length >= 1 && newData.child('nome').val().length <= 30 && newData.child('grupo').isString() && root.child('salas').child($sala).child('grupos').child(newData.child('grupo').val()).child('membros').child($uid).val() === true"
          }
        },
        "grupos": {
          ".read": "auth != null",
          "$gid": {
            ".write": "auth != null && newData.child('membros').child(auth.uid).val() === true && !data.child('membros').child(auth.uid).exists() && ((data.exists() && newData.child('cor').val() === data.child('cor').val() && newData.child('nome').val() === data.child('nome').val() && newData.child('ordem').val() === data.child('ordem').val()) || (!data.exists() && root.child('salas').child($sala).child('estado/fase').val() === 'lobby' && newData.child('cor').isString() && newData.child('nome').isString() && newData.child('ordem').isNumber()))",
            "membros": {
              "$uid": {
                ".validate": "newData.val() === true && ($uid === auth.uid || data.val() === true || (auth.token.email != null && root.child('admins').child(auth.token.email.toLowerCase().replace('.', ',')).val() === true))"
              }
            }
          }
        },
        "telas": {
          ".read": "auth != null",
          "$tid": {
            "componentes": {
              ".write": "auth != null && data.parent().child('dono').exists() && root.child('salas').child($sala).child('alunos').child(auth.uid).child('grupo').val() === data.parent().child('dono').val() && ((data.parent().child('rodada').val() === 1 && root.child('salas').child($sala).child('estado/fase').val().matches(/^(r1|r1_troca)$/)) || (data.parent().child('rodada').val() === 2 && root.child('salas').child($sala).child('estado/fase').val().matches(/^(r2|r2_troca)$/)))",
              "$i": {
                ".validate": "$i.matches(/^([0-9]|[12][0-9])$/) && newData.hasChildren(['id', 'tipo', 'texto'])",
                "id": {
                  ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20"
                },
                "tipo": {
                  ".validate": "newData.isString() && newData.val().matches(/^(titulo|botao|lista|filtro|busca|mapa|perfil|chat|pagamento|aviso)$/)"
                },
                "texto": {
                  ".validate": "newData.isString() && newData.val().length <= 300"
                },
                "editandoPor": {
                  ".validate": "newData.isString() && newData.val().length <= 128"
                },
                "$outro": {
                  ".validate": false
                }
              }
            },
            "avaliacaoR1": {
              "$c": {
                ".write": "auth != null && data.parent().parent().child('dono').exists() && root.child('salas').child($sala).child('alunos').child(auth.uid).child('grupo').val() === data.parent().parent().child('dono').val() && data.parent().parent().child('rodada').val() === 1 && root.child('salas').child($sala).child('estado/fase').val() === 'r1_avaliacao'",
                ".validate": "$c.matches(/^c[1-5]$/) && newData.isBoolean()"
              }
            },
            "declarados": {
              "$c": {
                ".write": "auth != null && data.parent().parent().child('dono').exists() && root.child('salas').child($sala).child('alunos').child(auth.uid).child('grupo').val() === data.parent().parent().child('dono').val() && data.parent().parent().child('rodada').val() === 2 && root.child('salas').child($sala).child('estado/fase').val().matches(/^(r2|r2_troca|r2_declaracao)$/)",
                ".validate": "$c.matches(/^c[1-5]$/) && newData.isBoolean()"
              }
            },
            "progresso": {
              ".write": "auth != null && data.parent().child('dono').exists() && root.child('salas').child($sala).child('alunos').child(auth.uid).child('grupo').val() === data.parent().child('dono').val() && data.parent().child('rodada').val() === 2 && !data.parent().child('saiu').exists() && (root.child('salas').child($sala).child('estado/fase').val() === 'r2' || (root.child('salas').child($sala).child('estado/fase').val() === 'r2_troca' && !root.child('salas').child($sala).child('trocas/r2_troca').exists()))",
              ".validate": "newData.isString() && newData.val().length <= 280"
            },
            "saiu": {
              ".write": "auth != null && data.parent().child('dono').exists() && root.child('salas').child($sala).child('alunos').child(auth.uid).child('grupo').val() === data.parent().child('dono').val() && data.parent().child('rodada').val() === 2 && root.child('salas').child($sala).child('estado/fase').val() === 'r2_troca' && !root.child('salas').child($sala).child('trocas/r2_troca').exists() && !data.exists() && data.parent().child('progresso').isString() && data.parent().child('progresso').val().matches(/[a-zA-Z0-9]/)",
              ".validate": "newData.hasChildren(['por', 'em'])",
              "por": {
                ".validate": "newData.val() === auth.uid"
              },
              "em": {
                ".validate": "newData.val() === now"
              },
              "$outro": {
                ".validate": false
              }
            },
            "revisao": {
              "aprovados": {
                "$c": {
                  ".write": "auth != null && data.parent().parent().child('revisor').exists() && root.child('salas').child($sala).child('alunos').child(auth.uid).child('grupo').val() === data.parent().parent().child('revisor').val() && data.parent().parent().parent().child('rodada').val() === 2 && root.child('salas').child($sala).child('estado/fase').val() === 'r3' && !data.parent().parent().child('enviadoEm').exists()",
                  ".validate": "$c.matches(/^c[1-5]$/) && newData.isBoolean()"
                }
              },
              "enviadoEm": {
                ".write": "auth != null && data.parent().child('revisor').exists() && root.child('salas').child($sala).child('alunos').child(auth.uid).child('grupo').val() === data.parent().child('revisor').val() && data.parent().parent().child('rodada').val() === 2 && root.child('salas').child($sala).child('estado/fase').val() === 'r3' && !data.exists() && (!root.child('salas').child($sala).child('config/criterios/c1').exists() || data.parent().child('aprovados/c1').isBoolean()) && (!root.child('salas').child($sala).child('config/criterios/c2').exists() || data.parent().child('aprovados/c2').isBoolean()) && (!root.child('salas').child($sala).child('config/criterios/c3').exists() || data.parent().child('aprovados/c3').isBoolean()) && (!root.child('salas').child($sala).child('config/criterios/c4').exists() || data.parent().child('aprovados/c4').isBoolean()) && (!root.child('salas').child($sala).child('config/criterios/c5').exists() || data.parent().child('aprovados/c5').isBoolean())",
                ".validate": "newData.val() === now"
              }
            }
          }
        },
        "trocas": {
          ".read": "auth != null"
        }
      }
    }
  }
}
